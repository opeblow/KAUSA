# ---------------------------------------------------------------------------
# Kausa — environment reference
#
# Client values (below, VITE_*) are pasted into the repo-root `.env.local`.
# Server values are set on the CONVEX deployment, not in this file, e.g.:
#     npx convex env set NVIDIA_API_KEY <key>
# Only the client values are read by the Vite app.
# ---------------------------------------------------------------------------

# --- Convex deployment (client) ---------------------------------------------
CONVEX_DEPLOYMENT=dev:<deployment-name>
VITE_CONVEX_URL=https://<deployment>.convex.cloud
VITE_CONVEX_SITE_URL=https://<deployment>.convex.site

# --- Auth (server, required) ------------------------------------------------
# Generated by `npx convex dev`. SITE_URL is the deployment's .convex.site URL.
SITE_URL=https://<deployment>.convex.site

# --- Narration providers (server, at least one optional) ---------------------
# Kausa picks the first configured provider (NVIDIA → SpaceXAI → Meterless) and
# falls back to a deterministic template if none is set. The model only writes
# prose about numbers computed in code; it never calculates and never sees rows.
LLM_PROVIDER=                 # optional: force "nvidia" | "spacexai" | "meterless"

# NVIDIA Nemotron via NIM (default)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# SpaceXAI (Grok) — OpenAI-compatible
SPACEXAI_API_KEY=
SPACEXAI_MODEL=grok-4
SPACEXAI_BASE_URL=https://api.x.ai/v1

# Meterless Runtime — OpenAI-compatible, billed by electricity
METERLESS_API_KEY=
METERLESS_MODEL=default
METERLESS_BASE_URL=https://api.meterless.ai/v1

# --- Zetaris AI Data Harness (server, optional) -----------------------------
# OPTIONAL. When fully configured, the analysis slice is read through Zetaris SQL
# federation; otherwise (or if Zetaris is unreachable) Kausa reads the local data
# store — the analysis is identical either way. Set none of these to force the
# local-store default.
#
# A loopback base URL (localhost / 127.0.0.1) is treated as unconfigured so the
# deployed backend never blocks on a local Docker stack; set ZETARIS_ALLOW_LOCAL=true
# to opt in (e.g. against a local Convex backend). For the hackathon Codespace,
# use the public forwarded URL, not localhost.
ZETARIS_BASE_URL=             # e.g. https://<codespace>-3000.app.github.dev (blank = local store)
ZETARIS_ORG_ID=opeblow2021-hobby
ZETARIS_API_KEY=              # hackathon bearer token
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_SOURCE=               # e.g. kausa.retail_sales
ZETARIS_ALLOW_LOCAL=false     # allow loopback base URL (local dev only)
