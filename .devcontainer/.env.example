# Reference only — .devcontainer/start-zetaris.sh does NOT auto-load this file.
# In a Codespace, set these as Codespaces secrets:
#   Repo → Settings → Secrets and variables → Codespaces → New secret
# or export them in your shell before running the script.

# Registry password for zetarishackathon.azurecr.io (from the Zetaris dashboard
# → Hackathon → "Run locally"). Username is set in devcontainer.json.
ZETARIS_ACR_PASSWORD=

# Optional: explicit path to the downloaded bundle zip.
# ZETARIS_BUNDLE=/workspaces/<repo>/zetaris-platform.zip
# Optional: download the bundle instead of committing it.
# ZETARIS_BUNDLE_URL=

# Optional: where the bundle is extracted (defaults to <repo>/zetaris).
# ZETARIS_DIR=
